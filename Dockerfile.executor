FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends docker.io && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY pyproject.toml .
COPY my_ai my_ai
RUN useradd --create-home --uid 10001 myai
USER myai
ENV HOST=0.0.0.0
ENV PORT=9000
EXPOSE 9000
CMD ["uvicorn","my_ai.executor_service:app","--host","0.0.0.0","--port","9000"]
