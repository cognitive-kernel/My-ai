# auto = use OpenAI when OPENAI_API_KEY is set; otherwise use local Ollama
LLM_PROVIDER=ollama
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
DB_PATH=data/myai.db
MAX_WEB_CHARS=30000
OLLAMA_NUM_CTX=8192
EXEC_TIMEOUT=10
HOST=127.0.0.1
PORT=8000

EXECUTOR_MODE=container
EXECUTOR_SHARED_TOKEN=replace-with-a-long-random-secret
EXECUTOR_SERVICE_URL=http://executor:9000
