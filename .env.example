# auto = use OpenAI when OPENAI_API_KEY is set; otherwise use local Ollama
LLM_PROVIDER=auto
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
ROUTER_MODEL=qwen2.5:1.5b
CODING_MODEL=qwen2.5:7b
FALLBACK_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_THREAD=6
OLLAMA_NUM_GPU=0
OLLAMA_KEEP_ALIVE=30m
DB_PATH=data/myai.db
MAX_WEB_CHARS=30000
OLLAMA_NUM_CTX=4096
MYAI_CACHE_TTL=60
EXEC_TIMEOUT=10
HOST=127.0.0.1
PORT=8000

EXECUTOR_MODE=container
EXECUTOR_SHARED_TOKEN=replace-with-a-long-random-secret
EXECUTOR_SERVICE_URL=http://executor:9000

# Docker group ID on the host for the isolated executor service
DOCKER_GID=999

MYAI_OFFLINE_STRICT=false
MYAI_DECISION_LOG=false
MYAI_NOTIFICATION_WEBHOOK=
MYAI_SELF_UPDATE_ENABLED=false
MYAI_SELF_UPDATE_APPROVED=false
