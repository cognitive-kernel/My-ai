# auto = use OpenAI when OPENAI_API_KEY is set; otherwise use local Ollama
LLM_PROVIDER=auto
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
ROUTER_MODEL=qwen2.5:7b
CODING_MODEL=qwen2.5:7b
FALLBACK_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_THREAD=8
OLLAMA_NUM_GPU=0
OLLAMA_KEEP_ALIVE=10m
DB_PATH=data/myai.db
MAX_WEB_CHARS=30000
OLLAMA_NUM_CTX=2048
MYAI_CACHE_TTL=60
EXEC_TIMEOUT=10
HOST=127.0.0.1
PORT=8000

EXECUTOR_MODE=container
EXECUTOR_SHARED_TOKEN=replace-with-a-long-random-secret
EXECUTOR_SERVICE_URL=http://executor:9000

# Docker group ID on the host for the isolated executor service
DOCKER_GID=999

MYAI_OFFLINE_STRICT=false
MYAI_DECISION_LOG=false
MYAI_NOTIFICATION_WEBHOOK=
MYAI_SELF_UPDATE_ENABLED=false
MYAI_SELF_UPDATE_APPROVED=false

SCHEDULER_INTERVAL_SECONDS=3600
SCHEDULER_MAX_CPU_PERCENT=70
SCHEDULER_MAX_RAM_PERCENT=80
SCHEDULER_AUTO_RESUME=false
LEARNING_MAX_RETRIES=5
MYAI_BACKUP_ROOT=data/backups
MYAI_SQLITE_ROOT=data/sqlite
WHISPER_CPP_BIN=

# Use the local routing model for ambiguous intent classification; deterministic rules remain the safety fallback.
ROUTER_LLM_ENABLED=true

# Learning runtime hardening
LEARNING_MAX_CONCURRENT_WORKERS=2
LEARNING_SOURCE_TIMEOUT_SECONDS=8
LEARNING_SOURCE_MAX_CHARS=12000
RESOURCE_WAIT_SECONDS=30
